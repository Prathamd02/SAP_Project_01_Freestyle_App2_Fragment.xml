<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="addProductDialog"
        title="Add Product"
        contentWidth="32rem"
    >
        <form:SimpleForm
            layout="ResponsiveGridLayout"
            editable="true"
        >
            <form:content>
                <!-- <Label text="ID" required="true"/>
                <Input id="inputID" placeholder="ID"/> -->

                <Label text="ID" required="true"/>
                <Input id="inputID" placeholder="0"/>

                <Label text="Name" required="true"/>
                <Input id="inputName" placeholder="ABC"/>

                <Label text="Release Date" required="true" />
                <DatePicker id="inputReleaseDate" placeholder="dd-MM-yyyy" />

                <Label text="Price" required="true"/>
                <Input id="inputPrice" placeholder="0.00" type="Number" />
                
            </form:content>
        </form:SimpleForm>

        <beginButton>
            <Button text="Submit" type="Emphasized" press="onCreateProduct"/>
        </beginButton>

        <endButton>
            <Button text="Cancel" type="Reject" press="OnCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
