<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="addProductDialog"
        title="Add Product"
        contentWidth="32rem"
    >
        <form:SimpleForm
            layout="ResponsiveGridLayout"
            editable="true"
        >
            <form:content>

                <Label text="{i18n>ID}" required="true"/>
                <Input id="inputID" value="{newProduct>/ID}" placeholder="0"/>

                <Label text="{i18n>name}" required="true"/>
                <Input id="inputName" value="{newProduct>/Name}"  placeholder="ABC"/>

                <Label text="{i18n>ReleaseDate}" required="true" />
                <DatePicker id="inputReleaseDate" value="{path: 'newProduct>/ReleaseDate' ,type:'sap.ui.model.type.Date', formatOptions:{pattern: 'dd-MM-yyyy'}}"  placeholder="dd-MM-yyyy" displayFormat="dd-MM-yyyy" />

                <Label text="{i18n>Price}" required="true"/>
                <Input id="inputPrice" value="{newProduct>/Price}"  placeholder="0.00" type="Number" />
                
            </form:content>
        </form:SimpleForm>

        <beginButton>
            <Button text="Submit" type="Emphasized" press="onCreateproductUsingJSONModel"/>
        </beginButton>

        <endButton>
            <Button text="Cancel" type="Reject" press="OnCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
